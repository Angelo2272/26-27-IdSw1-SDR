@startuml

state "Solicitado" as Solicitado
state "PendienteAsignación" as PendienteAsignacion
state "EnElaboración" as EnElaboracion
state "EnRevisión" as EnRevision
state "Entregado" as Entregado

[*] --> Solicitado

Solicitado --> PendienteAsignacion : recibir solicitud

PendienteAsignacion --> EnElaboracion : asignar responsable

EnElaboracion --> EnRevision : completar informe

EnRevision --> EnElaboracion : rechazar informe

EnRevision --> Entregado : validar informe

Entregado --> [*]

@enduml
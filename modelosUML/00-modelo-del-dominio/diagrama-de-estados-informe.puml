@startuml

state "Solicitado" as Solicitado
state "En elaboración" as EnElaboracion
state "En revisión" as EnRevision
state "Entregado" as Entregado

[*] --> Solicitado : Recibir solicitud

Solicitado --> EnElaboracion : Iniciar elaboración

EnElaboracion --> EnRevision : Completar informe

EnRevision --> EnElaboracion : Rechazar informe

EnRevision --> Entregado : Validar y entregar informe

Entregado --> [*]

@enduml
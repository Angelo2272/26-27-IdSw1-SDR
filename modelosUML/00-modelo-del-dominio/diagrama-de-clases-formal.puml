@startuml diagrama-de-clases-formal

hide circle
hide empty members
skinparam linetype polyline

class Convocatoria {
  codigoResolucion
  nombre
  promotor
  ambito
  año
  fechaConcesion
  fechaLimite
}

class Propuesta {
  codigo
  titulo
  tituloOtroIdioma
  descripcion
  tipo
  tipoContrato
  areaTematica
  palabrasClave
  programasDoctorado
  curso
  pais
  fechaEntrega
  fechaResolucion
  /fechaClave
  añoEntrega
  estado
  seguimientoExpediente
  lider
  socios
  presupuestoTotal
  presupuestoPropio
  subvencionPrevista
  prestamoPrevisto
  observaciones
}

class EntidadFinanciera {
}

class OrganismoExterno {
  nombre
}

class OrganismoInstitucional {
}

class Informe {
  codigo
  titulo
  tipo
  formato
  fechaSolicitud
  fechaEmision
  periodoCubierto
  estado
  contenidoAdicional
}

class Investigador {
  rol
}

class Auditor

class Proyecto {
  codigo
  titulo
  fechaInicio
  fechaFin
  estado
  presupuestoConcedido
  subvencionObtenida
  prestamoObtenido
  actividadesPropias
  observaciones
}

class GestorDeProyecto

class GestorDePropuesta

class Personal {
  nombre
  apellidos
  correo
  genero
  fechaDeNacimiento 
  estado
}

Personal <|-d- GestorDePropuesta
Personal <|-d- GestorDeProyecto
Personal <|-d- Auditor
Personal <|-d- Investigador

Propuesta "0..*" -u- "1" GestorDePropuesta : expone <
Proyecto "0..*" -u- "1" GestorDeProyecto : coordina <

OrganismoExterno <|-- EntidadFinanciera
OrganismoExterno <|-- OrganismoInstitucional

EntidadFinanciera "1" *-- "1..*" Convocatoria : abre
Propuesta "1" --> "0..1" Proyecto : se convierte
Convocatoria "1" o-- "0..*" Propuesta : recibe
Proyecto "0..*" <.u. "0..*" Auditor : revisa
EntidadFinanciera "1..*" -d- "0..*" Proyecto : financia >

Propuesta "0..*" -u- "1..*" Investigador : presenta y coordina <
Proyecto "0..*" -u- "1..*" Investigador : ejecuta <

OrganismoExterno "1" -d- "0..*" Informe : solicita >
Informe "0..*" ..> "0..*" Propuesta : refleja datos de
Informe "0..*" ..> "0..*" Proyecto : refleja datos de

@enduml
@startuml
scale 600 width

[*] --> EXPRESION_DE_INTERES : Registrar interés inicial

state EXPRESION_DE_INTERES
state EN_PREPARACION
state ENTREGADO
state EN_VALIDACION
state DESCARTADO
state RECHAZADO
state OBTENIDO
state NO_ACEPTADO

EXPRESION_DE_INTERES --> EN_PREPARACION : Formalizar propuesta
EXPRESION_DE_INTERES --> DESCARTADO : Cancelar interés
EN_PREPARACION --> ENTREGADO : Presentar a convocatoria
ENTREGADO --> EN_VALIDACION : Iniciar evaluación

EN_VALIDACION --> OBTENIDO : Concesión / crear proyecto
EN_VALIDACION --> RECHAZADO : Entidad deniega

EN_PREPARACION --> DESCARTADO : Cancelar antes de entregar
EN_VALIDACION --> NO_ACEPTADO : Concesión sin ayuda (Renuncia)

OBTENIDO --> [*]
RECHAZADO --> [*]
DESCARTADO --> [*]
NO_ACEPTADO --> [*]

@enduml
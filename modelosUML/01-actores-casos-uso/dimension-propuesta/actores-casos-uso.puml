@startuml
left to right direction
skinparam packageStyle rectangle
actor "UsuarioNoLogueado" as UsuarioNoLogueado
actor "Administrador" as Administrador
rectangle "Sistema de Gestión OTRI · Convocatorias y Propuestas" {
  package "Acceso al Sistema" {
    usecase "iniciarSesion()" as iniciarSesion
    usecase "cerrarSesion()" as cerrarSesion
  }

  package "Ciclo de Vida de la Propuesta" {
    usecase "crearPropuesta()" as formalizarPropuesta
    usecase "editarPropuesta()" as editarPropuesta
    usecase "abrirPropuesta()" as abrirPropuesta
    usecase "convertirProyecto()" as convertirProyecto
  }
}
UsuarioNoLogueado --> iniciarSesion
Administrador--> cerrarSesion
Administrador--> formalizarPropuesta
Administrador--> editarPropuesta
Administrador--> abrirPropuesta
Administrador--> convertirProyecto
@enduml
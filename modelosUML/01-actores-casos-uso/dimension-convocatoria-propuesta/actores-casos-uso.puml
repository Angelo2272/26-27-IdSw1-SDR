@startuml
left to right direction

actor UsuarioNoLogueado
actor Administrador

package "Gestión de Propuestas" {
  usecase "abrirPropuestas()" as UC_AbrirProp
  usecase "crearPropuesta()" as UC_CrearProp
  usecase "editarPropuesta()" as UC_EditarProp
  usecase "abrirHistorial()" as UC_AbrirHist
  usecase "asignarPersonal()" as UC_Asignar
  usecase "desasignarPersonal()" as UC_Desasignar
  usecase "convertirAProyecto()" as UC_Convertir
}

package "Acceso al Sistema" {
  usecase "iniciarSesion()" as UC_Iniciar
  usecase "cerrarSesion()" as UC_Cerrar
}

package "Gestión de Convocatorias" {
  usecase "abrirConvocatorias()" as UC_AbrirConv
  usecase "crearConvocatoria()" as UC_CrearConv
  usecase "editarConvocatoria()" as UC_EditarConv
}

' Izquierda del actor (con left to right direction, <-- coloca el destino a la izquierda)
UC_AbrirProp <-- Administrador
UC_CrearProp <-- Administrador
UC_EditarProp <-- Administrador
UC_AbrirHist <-- Administrador
UC_Asignar <-- Administrador
UC_Desasignar <-- Administrador
UC_Convertir <-- Administrador

' Derecha de los actores (--> coloca el destino a la derecha)
UsuarioNoLogueado --> UC_Iniciar
Administrador --> UC_Cerrar

Administrador --> UC_AbrirConv
Administrador --> UC_CrearConv
Administrador --> UC_EditarConv

@enduml
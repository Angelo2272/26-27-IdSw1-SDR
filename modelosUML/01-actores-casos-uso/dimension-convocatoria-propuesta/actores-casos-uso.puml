@startuml
left to right direction

skinparam packageStyle rectangle
skinparam shadowing false

actor "UsuarioNoLogueado" as Usuario
actor "PersonalOTRI" as Personal

rectangle "Sistema de Gestión OTRI" {

    package "Acceso al Sistema" {
        usecase "iniciarSesion()" as UC1
        usecase "cerrarSesion()" as UC2
    }

    package "Gestión de Propuestas" {
        usecase "abrirPropuestas()" as UC3
        usecase "crearPropuesta()" as UC4
        usecase "editarPropuesta()" as UC5
        usecase "abrirHistorial()" as UC6
        usecase "asignarPersonal()" as UC7
        usecase "desasignarPersonal()" as UC8
        usecase "convertirAProyecto()" as UC9
    }

    package "Gestión de Convocatorias" {
        usecase "abrirConvocatorias()" as UC10
        usecase "crearConvocatoria()" as UC11
        usecase "editarConvocatoria()" as UC12
    }
}

' Acceso al sistema
Usuario --> UC1

' Personal OTRI
Personal --> UC2

' Gestión de propuestas
Personal --> UC3
Personal --> UC4
Personal --> UC5
Personal --> UC6
Personal --> UC7
Personal --> UC8
Personal --> UC9

' Gestión de convocatorias
Personal --> UC10
Personal --> UC11
Personal --> UC12

@enduml